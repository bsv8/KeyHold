{
  "name": "keyhold-docs",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run api:generate && npm run check:i18n && tsc --noEmit",
    "dev": "npm run api:generate && npm run check:i18n && docusaurus start",
    "build": "npm run api:generate && npm run check:i18n && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "~5.6.2",
    "typedoc": "0.28.20",
    "webpack": "5.95.0"
  }
}
