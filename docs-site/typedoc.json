{
  "$schema": "https://typedoc.org/schema.json",
  "name": "KeyHold TypeScript SDK",
  "entryPoints": ["../typescript/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "../typescript/tsconfig.build.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme", "./typedoc-interface-overview.mjs"],
  "theme": "keyhold-docs",
  "out": "site/api",
  "docsRoot": "site",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "disableSources": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  }
}
